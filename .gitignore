# deps
node_modules/
.pnpm-store/

# build
.next/
out/
dist/
.turbo/
*.tsbuildinfo

# prisma generated client
packages/db/generated/
# copies of the query engine, placed next to each app at build time
apps/*/generated/

# env
.env
.env.*
!.env.example
!.env.remote.example

# vercel
.vercel/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# coverage
coverage/

# playwright — reports, traces, and the signed-in cookie jars the setup project
# writes. `.auth/` holds real session tokens: never commit it.
e2e/.auth/
e2e/playwright-report/
e2e/test-results/
e2e/blob-report/

# agent instructions — local, not shared
CLAUDE.md

# NOTE: `.vercel` and `.env*` were appended here by the Vercel CLI. Both are
# already covered above, and the bare `.env*` silently cancelled the
# `!.env.example` exception — the last matching pattern wins in .gitignore.

# local audio store (dev/e2e AudioStore; production uses Vercel Blob)
.data/
