# ---------------------------------------------------------------------------
# Copy to .env (repo root) for local dev. NEVER commit a filled-in .env.
# In production these live in the two Vercel Projects' Environment Variables.
# ---------------------------------------------------------------------------

# --- Database: Neon PostgreSQL ------------------------------------------------
# DATABASE_URL = pooled connection (runtime queries)
# DIRECT_URL   = direct connection (prisma migrate / introspect)
# Local docker-compose defaults below.
DATABASE_URL="postgresql://app:app@localhost:5432/app_platform?schema=public"
DIRECT_URL="postgresql://app:app@localhost:5432/app_platform?schema=public"

# Optional. Set this ONLY when the database is shared with another project and
# our tables need their own PostgreSQL schema. It rewrites both URLs above, so
# it works even where DATABASE_URL is injected read-only (the Neon integration
# on Vercel). An explicit `?schema=` in the URL wins. Prisma creates the schema
# on first migrate; leaving this unset keeps everything in `public`.
# DATABASE_SCHEMA="app_platform"

# --- Redis: Upstash (REST) ----------------------------------------------------
# Local docker-compose exposes an Upstash-compatible REST endpoint on :8079.
# The Vercel Marketplace Upstash integration injects the same credentials as
# KV_REST_API_URL / KV_REST_API_TOKEN instead; the code accepts either pair.
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local_dev_token"

# --- Auth.js ------------------------------------------------------------------
# MUST be different per app (SPEC §1.4 / §7). Generate with: openssl rand -base64 32
AUTH_SECRET_APP="replace-me-app-web-secret-at-least-32-chars"
AUTH_SECRET_ADMIN="replace-me-admin-web-secret-at-least-32-chars"
# Redundant: both apps set `trustHost: true` in code. Kept only because Auth.js
# reads this name by convention — you do not need to set it on Vercel.
AUTH_TRUST_HOST="true"

# Email + password is the only sign-in method; there is no OAuth provider.

# --- Email: Resend ------------------------------------------------------------
# Leave RESEND_API_KEY empty in local dev: reset links are printed to the server
# console instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Public URLs --------------------------------------------------------------
# NEXT_PUBLIC_APP_URL is the base of the password-reset link. Set it wherever
# app-web runs, or reset emails point at localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Reserved: nothing reads this yet.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# --- Seed (local only) --------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="super@local.dev"
SEED_SUPER_ADMIN_PASSWORD="LocalDev!2345"

# --- End-to-end suite (local only) -------------------------------------------
# `pnpm e2e` starts both apps itself and signs in as the seeded super admin above.
# Set these two only when 3000/3001 are already taken by another project; the
# suite then starts the apps on whatever ports these URLs name.
# E2E_APP_URL="http://localhost:3100"
# E2E_ADMIN_URL="http://localhost:3101"

# --- Daily speaking (docs/spec/IMPL-daily-speaking-mvp-in-app-platform.md) ----
# Sign-in codes: with RESEND_API_KEY empty they are printed to the server console
# like reset links. OTP_DEV_ECHO additionally returns the code in the HTTP
# response so an automated test can read it — the route refuses to do this on a
# production deployment whatever this says. Never set it on a real environment.
# OTP_DEV_ECHO="1"

# Speech provider. `stub` is deterministic, free and offline; it is the default,
# and it stays the fallback running mode when the Azure free quota is spent.
# The `azure` implementation lands in M5.
SPEECH_PROVIDER="stub"

# Where recorded takes are stored. The local filesystem store is dev/CI only —
# production uses Vercel Blob (M5), and the database only ever holds a key.
# SPEAKING_AUDIO_DIR=".data/audio"
# Serve silence for 示范音 keys whose files content ops has not produced yet.
# Development and e2e only; refused on a production deployment.
# SPEAKING_AUDIO_PLACEHOLDER="1"

# The 30-90s window a take must fall in (SPEC §4.1). Overridden only by the e2e
# suite, which cannot afford to speak for a real 30 seconds per browser spec.
# SPEAKING_MIN_DURATION_MS="30000"
# SPEAKING_MAX_DURATION_MS="90000"
