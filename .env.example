# ---------------------------------------------------------------------------
# Copy to .env (repo root) for local dev. NEVER commit a filled-in .env.
# In production these live in the two Vercel Projects' Environment Variables.
# ---------------------------------------------------------------------------

# --- Database: Neon PostgreSQL ------------------------------------------------
# DATABASE_URL = pooled connection (runtime queries)
# DIRECT_URL   = direct connection (prisma migrate / introspect)
# Local docker-compose defaults below.
DATABASE_URL="postgresql://app:app@localhost:5432/app_platform?schema=public"
DIRECT_URL="postgresql://app:app@localhost:5432/app_platform?schema=public"

# --- Redis: Upstash (REST) ----------------------------------------------------
# Local docker-compose exposes an Upstash-compatible REST endpoint on :8079.
# The Vercel Marketplace Upstash integration injects the same credentials as
# KV_REST_API_URL / KV_REST_API_TOKEN instead; the code accepts either pair.
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local_dev_token"

# --- Auth.js ------------------------------------------------------------------
# MUST be different per app (SPEC §1.4 / §7). Generate with: openssl rand -base64 32
AUTH_SECRET_APP="replace-me-app-web-secret-at-least-32-chars"
AUTH_SECRET_ADMIN="replace-me-admin-web-secret-at-least-32-chars"
# Redundant: both apps set `trustHost: true` in code. Kept only because Auth.js
# reads this name by convention — you do not need to set it on Vercel.
AUTH_TRUST_HOST="true"

# Email + password is the only sign-in method; there is no OAuth provider.

# --- Email: Resend ------------------------------------------------------------
# Leave RESEND_API_KEY empty in local dev: reset links are printed to the server
# console instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Public URLs --------------------------------------------------------------
# NEXT_PUBLIC_APP_URL is the base of the password-reset link. Set it wherever
# app-web runs, or reset emails point at localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Reserved: nothing reads this yet.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# --- Seed (local only) --------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL="super@local.dev"
SEED_SUPER_ADMIN_PASSWORD="LocalDev!2345"
