{
  "name": "app-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:schema-owner": "node scripts/check-schema-ownership.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @app/e2e run test",
    "e2e:ui": "pnpm --filter @app/e2e run test:ui",
    "e2e:report": "pnpm --filter @app/e2e run report",
    "e2e:browsers": "pnpm --filter @app/e2e run browsers",
    "db:generate": "pnpm --filter @app/db run generate",
    "db:migrate": "pnpm --filter @app/db run migrate:dev",
    "db:deploy": "pnpm --filter @app/db run migrate:deploy",
    "db:seed": "pnpm --filter @app/db run seed",
    "db:validate": "pnpm --filter @app/db run validate",
    "speaking:import": "pnpm --filter @app/db run speaking:import",
    "speaking:seed": "pnpm --filter @app/db run speaking:import prisma/content/speaking-prompts.seed.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.prisma": [
      "prettier --write"
    ]
  }
}
