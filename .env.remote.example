# ---------------------------------------------------------------------------
# Copy to .env.remote (git-ignored) and fill in. Used ONLY by
# docker-compose.remote.yml, which runs the apps locally against the real
# Vercel-side services.
#
# Fastest way to fill it, from a directory linked with `vercel link`:
#
#   vercel env pull .env.remote --environment=production
#
# Both Vercel projects point at the same Neon store and the same Upstash
# database, so a pull from either one covers the connection settings. The two
# AUTH_SECRET_* values only sign cookies — any 32+ character string works here,
# and using values different from production is the safer choice.
#
# ⚠  This file grants full read/write access to production data. Never commit
#    it; `.gitignore` already covers `.env.*`.
# ---------------------------------------------------------------------------

# Neon pooled connection string (the host contains `-pooler`).
DATABASE_URL=

# Only needed if the Neon database is shared with another project. Must match
# the value set in both Vercel projects, or the apps read the wrong tables.
DATABASE_SCHEMA=app_platform

# Upstash. The Vercel Marketplace integration names these KV_REST_API_URL /
# KV_REST_API_TOKEN; either pair is accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Must differ from each other (SPEC §1.4). Generate with:
#   openssl rand -base64 32
AUTH_SECRET_APP=
AUTH_SECRET_ADMIN=

# Leave empty to print password-reset links to the container log instead of
# sending real email — usually what you want while testing.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# DIRECT_URL is intentionally absent: it is a Prisma CLI setting for migrations,
# and nothing in a running app reads it. Migrations run from packages/db.
